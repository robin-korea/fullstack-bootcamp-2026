 <!-- application 객체 파라미터 선언 -->
 <context-param>
 	<description>DB 사용자 계정</description>
 	<param-name>user</param-name>
 	<param-value>SCOTT</param-value>
 </context-param>
 <context-param>
 	<description>DB 비밀번호</description>
 	<param-name>password</param-name>
 	<param-value>tiger</param-value>
 </context-param>
 <context-param>
 	<description>파일 경로</description>
 	<param-name>path</param-name>
 	<param-value>/days06</param-value>
 </context-param>
 
 <resource-ref>
 <description>Oracle Datasource example</description>
 <res-ref-name>jdbc/myoracle</res-ref-name>
 <res-type>javax.sql.DataSource</res-type>
 <res-auth>Container</res-auth>
</resource-ref>

<!-- MVC 패턴 게시판 구현할 때 컨트롤러 서블릿 등록 부분 -->
  <servlet>
  	<servlet-name>dispatcher</servlet-name>
  	<servlet-class>days07.mvc.board.controller.DispatcherServlet</servlet-class>
  	<init-param>
  		<description>요청URL과 커멘드 핸들러 매핑</description>
  		<param-name>urlMappingPath</param-name>
  		<param-value>/WEB-INF/commandHandler.properties</param-value>
  	</init-param>
  	<load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
  	<servlet-name>dispatcher</servlet-name>
  	<url-pattern>*.htm</url-pattern>
  </servlet-mapping>
  
  
</web-app>


