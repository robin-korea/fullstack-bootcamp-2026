<?xml version="1.0" encoding="UTF-8"?>
 <!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.doit.ik.mapper.BoardMapper">
   
   <!-- [1] 게시글 목록 List<BoardVO> getList(); -->
   <select id="getList" resultType="org.doit.ik.domain.BoardVO">
     <![CDATA[
	    SELECT *
	    FROM tbl_board
	    WHERE bno > 0
	    ORDER BY bno DESC 
     ]]>
   </select>
   
    <!--
    [1-2] 게시글 목록 + 페이징처리 O
	List<BoardVO> getListWithPaging(Criteria criteria);
	int getTotalCount (Criteria criteria); 
	-->
   
    <!-- <select id="getListWithPaging" resultType="org.doit.ik.domain.BoardVO">
	 <![CDATA[
	    SELECT bno, title, content, writer, regdate, updatedate
     	FROM (
            SELECT /*+INDEX_DESC(tbl_board pk_tblboard_bno)*/
                   rownum rn, bno, title, content, writer, regdate, updatedate
            FROM tbl_board
            WHERE rownum <= #{ pageNum } * #{ amount }
           )
     	WHERE rn > (#{ pageNum } - 1) * #{ amount }
     ]]>
   </select> -->
   
   <sql id="searchCondition">
   		<trim prefix="(" suffix=") AND" prefixOverrides="OR">
     		<foreach collection="typeArr" item="type">
     			<trim prefix="OR">
     				<choose>
     					<when test="type=='T'.toString()">REGEXP_LIKE( title , #{ keyword }, 'i')</when>
     					<when test="type=='C'.toString()">REGEXP_LIKE( content , #{ keyword }, 'i')</when>
     					<when test="type=='W'.toString()">REGEXP_LIKE( writer , #{ keyword }, 'i')</when>
     				</choose>
     			</trim>
     		</foreach>	
     	</trim>
   </sql>
   
   
   <!-- [1-3] 게시글 목록 + 페이징 처리 + 검색정리 -->
   <select id="getListWithPaging" resultType="org.doit.ik.domain.BoardVO">
	 <![CDATA[
	    SELECT bno, title, content, writer, regdate, updatedate
     	FROM (
            SELECT /*+INDEX_DESC(tbl_board pk_tblboard_bno)*/
                   rownum rn, bno, title, content, writer, regdate, updatedate
            FROM tbl_board
            WHERE 
     ]]>
     <include refid="searchCondition"></include>
     <![CDATA[ 
            rownum <= #{ pageNum } * #{ amount }
           )
     	WHERE rn > (#{ pageNum } - 1) * #{ amount }
     ]]>
   </select>
   
   
   <select id="getTotalCount" resultType="int">
	   	
	   	SELECT COUNT(*)
	   	FROM tbl_board
   		WHERE 
   		<include refid="searchCondition"></include>
   	<![CDATA[	
   		bno > 0
   	]]>
   </select>
   

   <!-- [2] 게시글 쓰기 int insert(BoardVO boardVO);
         #{title}  == boardVO.getTitle()   getter 가 있어야 된다.
    -->
   <insert id="insert" parameterType="org.doit.ik.domain.BoardVO">
     INSERT INTO tbl_board (bno, title, content, writer)
     VALUES ( seq_board.nextval,  #{title}, #{content}, #{writer})
   </insert>
   
   <!-- [2-2]  int insertSelectKey(BoardVO boardVO); -->
   <insert id="insertSelectKey" parameterType="org.doit.ik.domain.BoardVO">
    <selectKey order="BEFORE" resultType="long" keyProperty="bno">
       SELECT  seq_board.nextval
       FROM dual
    </selectKey>
    INSERT INTO tbl_board (bno, title, content, writer)
     VALUES ( #{bno},  #{title}, #{content}, #{writer})   
   </insert>
   
   <!-- [3] 게시글 상세보기 BoardVO read(Long bno); -->
   <select id="read" resultType="org.doit.ik.domain.BoardVO" parameterType="long">
     SELECT * 
     FROM tbl_board
     WHERE bno = #{bno}
   </select>
   
   <!--  [4] 게시글 삭제	int delete(@Param("bno") Long bno); -->
   <delete id="delete">
     DELETE FROM tbl_board
     WHERE bno = #{bno}
   </delete>
   
   <!-- [5] 게시글 수정  int update(BoardVO boardVO); -->
   <update id="update">
   	 UPDATE tbl_board
   	 SET title = #{title}, content = #{content}, updatedate = SYSDATE
   	 WHERE bno = #{bno}
   </update>
   
</mapper>  








 